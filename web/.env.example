# ---------- 基础 ----------
# 站点对外地址（nginx 反代后的域名或 IP:端口），用于 canonical / RSS / 埋点白名单
PUBLIC_SITE_URL=http://127.0.0.1:3100

# ---------- 数据库 ----------
DATABASE_URL=postgresql://nepenthe:nepenthe@127.0.0.1:5432/nepenthe?schema=public

# ---------- 后台 ----------
# 首次启动用这份口令创建 AdminUser；之后改这里并删掉库里的 AdminUser 行即可重置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nepenthe-admin
# 签名密钥，多实例/重启后登录态要延续就必须固定
SECRET_KEY=please-change-me-32-bytes-min

# ---------- 缓存 ----------
# 预留：留空则直接读库；接了 Redis 后用于发布时按版本号失效
REDIS_URL=

# ---------- 搜索 ----------
# 留空则退回 PostgreSQL 全文检索（trigram/ILIKE），填了走 Meilisearch
MEILI_HOST=
MEILI_KEY=

# ---------- 音乐代理 ----------
# 网易云登录 Cookie，填了能放完整歌曲；不填只有试听片段
NETEASE_COOKIE=

# ---------- 访问统计 ----------
# 只信任反向代理写的 X-Forwarded-For 时设 1（容器部署默认 1）
TRUST_PROXY=1

# ---------- 仅供 docker compose 使用 ----------
# POSTGRES_PASSWORD=换成强口令
# MEILI_KEY=换成强口令
# WEB_IMAGE=ghcr.io/你的用户名/仓库名/web:latest

# QQ 音乐：曲目 id 填字母数字（songmid）时用它拿播放地址，不填则只能放网易云
# 取法：登录 y.qq.com 后浏览器里复制整条 cookie，至少含 uin= 和 qm_keyst=
QQ_COOKIE=
